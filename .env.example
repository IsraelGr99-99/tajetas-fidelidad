# =====================================================================
# Café Nómada · Fidelidad — variables de entorno
# Copia este archivo a `.env.local` y llena los valores. NUNCA subas
# `.env.local` a Git. En producción, usa el gestor de secretos del hosting.
# NEXT_PUBLIC_* se envía al navegador: jamás pongas secretos ahí.
# =====================================================================

# --- Aplicación ------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_URL=https://iautomexa.com

# --- Supabase (Dashboard > Project Settings > API Keys) --------------
NEXT_PUBLIC_SUPABASE_URL=
# Llave publicable (sb_publishable_...). Segura en el navegador solo porque RLS está activo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (sb_secret_...). SOLO servidor. Omite RLS: usar únicamente en tareas administrativas.
SUPABASE_SECRET_KEY=

# --- Secretos propios de la app (generar con: openssl rand -base64 48) ---
# Pepper para HMAC de folios de ticket (pseudonimiza la referencia de compra). Mínimo 32 caracteres.
PURCHASE_REFERENCE_PEPPER=

# --- Cliente ----------------------------------------------------------
# Empresa del piloto (slug en la tabla businesses).
NEXT_PUBLIC_BUSINESS_SLUG=cafe-nomada
# true solo cuando Supabase Auth tenga proveedor SMS configurado.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# --- Apple Wallet (vacío = integración "no configurada") --------------
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
# Certificado y llave del Pass Type ID en PEM, codificados en base64.
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
APPLE_PASS_KEY_PASSPHRASE=
# Certificado intermedio Apple WWDR (G4) en PEM, base64.
APPLE_WWDR_CERT_BASE64=
# Llave APNs (.p8) para avisar actualizaciones de pases.
APPLE_APNS_KEY_ID=
APPLE_APNS_KEY_BASE64=

# --- Google Wallet (vacío = integración "no configurada") -------------
GOOGLE_WALLET_ISSUER_ID=
# JSON de la cuenta de servicio, en base64.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=
# demo = issuer en modo prueba (solo cuentas de prueba); public = emisión aprobada por Google.
GOOGLE_WALLET_MODE=demo

# --- Supabase Auth: SMS (lo lee Supabase CLI en local, no la app) -----
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Pruebas e2e ------------------------------------------------------
E2E_PORT=3100
